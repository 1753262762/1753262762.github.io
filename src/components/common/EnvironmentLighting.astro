---
import DawnAperture from '../lighting/DawnAperture.astro';
import PineKomorebi from '../lighting/PineKomorebi.astro';
import RiverField from '../lighting/RiverField.astro';
---

<div class="environment-lighting" data-environment-lighting aria-hidden="true" transition:persist="environment-lighting">
  <DawnAperture />
  <PineKomorebi />
  <RiverField />
</div>

<aside class="environment-switcher" data-environment-controller transition:persist="environment-controller" aria-label="日夜环境">
  <div class="environment-buttons" role="group" aria-label="切换 Summer 或 Night">
    <span aria-hidden="true">光景</span>
    <button type="button" data-environment-choice="summer" aria-pressed="true"><i aria-hidden="true">日</i>Summer</button>
    <button type="button" data-environment-choice="night" aria-pressed="false"><i aria-hidden="true">月</i>Night</button>
  </div>
</aside>

<script>
  import {
    DEFAULT_LIGHTING_PRESET,
    DEFAULT_LIGHTING_REGISTER,
    ENVIRONMENT_STORAGE_KEY,
    isRegister,
    lightingLiterature,
    lightingPresetIds,
    type EnvironmentMode,
    type LightingPreset,
    type LightingRegister,
  } from '../../lib/environment';

  declare global {
    interface WindowEventMap {
      'nabunana:environment-change': CustomEvent<{ environment: EnvironmentMode; preset: LightingPreset; register: LightingRegister; source: 'system' | 'user' | 'preview' | 'restore' }>;
      'nabunana:environment-preview': CustomEvent<{ environment: EnvironmentMode; preset: LightingPreset }>;
    }
  }

  let environmentAbort: AbortController | undefined;
  let environmentFrame = 0;

  const isEnvironment = (value: string | null): value is EnvironmentMode => value === 'summer' || value === 'night';
  const isPreset = (value: string | null): value is LightingPreset => lightingPresetIds.includes(value as LightingPreset);

  const readStoredEnvironment = (): EnvironmentMode | null => {
    try {
      const saved = localStorage.getItem(ENVIRONMENT_STORAGE_KEY);
      return isEnvironment(saved) ? saved : null;
    } catch {
      return null;
    }
  };

  const updateEnvironmentUi = (environment: EnvironmentMode) => {
    document.querySelectorAll<HTMLButtonElement>('[data-environment-choice]').forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.environmentChoice === environment));
    });

    document.querySelectorAll<HTMLElement>('[data-environment-season]').forEach((node) => {
      node.textContent = environment === 'summer' ? '夏 / SUMMER' : '夜 / NIGHT';
    });

    document.querySelectorAll<HTMLElement>('[data-lighting-whisper]').forEach((node) => {
      const line = node.querySelector<HTMLElement>('.whisper-line');
      const author = node.querySelector<HTMLElement>('cite');
      const literary = lightingLiterature['dawn-window'][environment];
      if (line) line.textContent = literary.line;
      if (author) author.textContent = literary.author;
    });
  };

  const applyEnvironment = (
    environment: EnvironmentMode,
    preset: LightingPreset,
    register: LightingRegister,
    source: 'system' | 'user' | 'preview' | 'restore',
    persist = false,
  ) => {
    const root = document.documentElement;
    root.dataset.environment = environment;
    root.dataset.theme = environment === 'night' ? 'dark' : 'light';
    root.dataset.lightingPreset = preset;
    root.dataset.lightingRegister = register;
    if (document.body) document.body.dataset.lightingRegister = register;

    if (persist) {
      try {
        localStorage.setItem(ENVIRONMENT_STORAGE_KEY, environment);
        localStorage.removeItem('theme');
      } catch {
        // The visual state still works when storage is blocked.
      }
    }

    updateEnvironmentUi(environment);
    window.dispatchEvent(new CustomEvent('nabunana:environment-change', {
      detail: { environment, preset, register, source },
    }));
  };

  const setupEnvironment = () => {
    environmentAbort?.abort();
    environmentAbort = new AbortController();
    const { signal } = environmentAbort;
    const root = document.documentElement;
    const systemTheme = matchMedia('(prefers-color-scheme: dark)');
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const params = new URL(location.href).searchParams;
    const previewPreset = isPreset(params.get('lightingPreset')) ? params.get('lightingPreset') as LightingPreset : null;
    const previewEnvironmentValue = params.get('environment') ?? params.get('mood');
    const previewEnvironment = isEnvironment(previewEnvironmentValue) ? previewEnvironmentValue : null;
    const pageRegister = isRegister(document.body?.dataset.lightingRegister) ? document.body.dataset.lightingRegister : DEFAULT_LIGHTING_REGISTER;
    const previewEnabled = params.get('lightingPreview') === '1' || pageRegister === 'lab';
    const previewActive = previewEnabled && Boolean(previewPreset || (pageRegister === 'lab' && previewEnvironment));
    const stored = readStoredEnvironment();
    const initialEnvironment = (previewActive ? previewEnvironment : null) ?? stored ?? (systemTheme.matches ? 'night' : 'summer');
    const initialPreset = previewActive && previewPreset ? previewPreset : DEFAULT_LIGHTING_PRESET;
    const initialRegister: LightingRegister = previewActive ? 'lab' : pageRegister;

    applyEnvironment(initialEnvironment, initialPreset, initialRegister, previewActive ? 'preview' : stored ? 'restore' : 'system');

    document.querySelectorAll<HTMLButtonElement>('[data-environment-choice]').forEach((button) => {
      button.addEventListener('click', () => {
        const environment = button.dataset.environmentChoice ?? null;
        if (!isEnvironment(environment)) return;
        const preset = isPreset(root.dataset.lightingPreset ?? null) ? root.dataset.lightingPreset as LightingPreset : DEFAULT_LIGHTING_PRESET;
        const register = isRegister(root.dataset.lightingRegister) ? root.dataset.lightingRegister : DEFAULT_LIGHTING_REGISTER;
        applyEnvironment(environment, preset, register, 'user', true);
      }, { signal });
    });

    systemTheme.addEventListener('change', (event) => {
      if (readStoredEnvironment()) return;
      const preset = isPreset(root.dataset.lightingPreset ?? null) ? root.dataset.lightingPreset as LightingPreset : DEFAULT_LIGHTING_PRESET;
      const register = isRegister(root.dataset.lightingRegister) ? root.dataset.lightingRegister : DEFAULT_LIGHTING_REGISTER;
      applyEnvironment(event.matches ? 'night' : 'summer', preset, register, 'system');
    }, { signal });

    window.addEventListener('nabunana:environment-preview', (event) => {
      applyEnvironment(event.detail.environment, event.detail.preset, 'lab', 'preview');
    }, { signal });

    const resetParallax = () => {
      root.style.setProperty('--light-shift-x', '0px');
      root.style.setProperty('--light-shift-y', '0px');
    };

    if (!reducedMotion.matches) {
      window.addEventListener('pointermove', (event) => {
        if (environmentFrame) cancelAnimationFrame(environmentFrame);
        environmentFrame = requestAnimationFrame(() => {
          const range = event.pointerType === 'touch' ? 2 : 4;
          const x = ((event.clientX / Math.max(innerWidth, 1)) - .5) * range * 2;
          const y = ((event.clientY / Math.max(innerHeight, 1)) - .5) * range * 1.25;
          root.style.setProperty('--light-shift-x', `${x.toFixed(2)}px`);
          root.style.setProperty('--light-shift-y', `${y.toFixed(2)}px`);
        });
      }, { passive: true, signal });
      window.addEventListener('blur', resetParallax, { signal });
    } else {
      resetParallax();
    }

    document.addEventListener('visibilitychange', () => {
      root.classList.toggle('lighting-paused', document.hidden);
    }, { signal });
  };

  document.addEventListener('astro:page-load', setupEnvironment);
  document.addEventListener('astro:after-swap', setupEnvironment);
  setupEnvironment();
</script>

<style is:global>
  .environment-switcher{position:fixed;z-index:75;right:max(14px,env(safe-area-inset-right));bottom:max(14px,env(safe-area-inset-bottom));display:flex;align-items:stretch;gap:7px;color:var(--text);transition:bottom .25s var(--ease),opacity .2s ease}
  .environment-buttons{display:flex;align-items:center;gap:2px;padding:4px;border:1px solid var(--border);border-radius:8px;background:color-mix(in srgb,var(--surface) 88%,transparent);box-shadow:0 12px 36px rgb(var(--lighting-shadow)/.12);backdrop-filter:blur(16px)}.environment-buttons>span{padding:0 6px;color:var(--muted);font:.52rem var(--font-mono);letter-spacing:.08em}.environment-buttons button{display:inline-flex;min-height:44px;align-items:center;gap:5px;padding:0 10px;border:0;border-radius:5px;background:transparent;color:var(--muted);font:600 .58rem var(--font-mono);cursor:pointer}.environment-buttons button i{font:500 .72rem var(--font-serif);font-style:normal}.environment-buttons button[aria-pressed='true']{background:var(--accent-deep);color:#f3fffd}.environment-buttons button:hover:not([aria-pressed='true']){background:color-mix(in srgb,var(--surface-2) 82%,transparent);color:var(--text)}
  .prototype-acg .environment-switcher{bottom:76px}
  .lighting-lab-page .environment-switcher{display:none}
  @media(max-width:700px){.environment-switcher{right:max(10px,env(safe-area-inset-right));bottom:calc(78px + env(safe-area-inset-bottom));max-width:calc(100vw - 20px);align-items:flex-end}.environment-buttons>span{display:none}.environment-buttons button{min-width:54px;padding-inline:7px}body:has(.site-player[data-expanded='true']) .environment-switcher{bottom:calc(154px + env(safe-area-inset-bottom))}body:has(.site-player[data-library-open='true']) .environment-switcher{opacity:0;pointer-events:none}}
  @media(max-width:390px){.environment-buttons button{min-width:50px;font-size:.53rem}}
  @media(prefers-reduced-motion:reduce){.environment-switcher{transition:none}}
</style>
