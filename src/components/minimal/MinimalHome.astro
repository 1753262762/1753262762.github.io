---
import type { CollectionEntry } from 'astro:content';
interface Props { posts: CollectionEntry<'blog'>[]; projects: CollectionEntry<'projects'>[]; }
const { posts, projects } = Astro.props;
const format = (date: Date) => date.toISOString().slice(0, 10).replaceAll('-', '.');
---
<main>
  <section class="minimal-hero container" id="top">
    <p class="index">01 / DIGITAL GARDEN</p>
    <h1>Hello, I'm <span>nabunana.</span></h1>
    <p class="statement">I build things,<br />write notes,<br />and explore the web.</p>
    <a class="scroll" href="#writing">Scroll to read <span>↓</span></a>
  </section>

  <section class="currently container" aria-labelledby="currently-title">
    <h2 id="currently-title">Currently</h2>
    <dl>
      <div><dt>Writing</dt><dd>实时系统、Agent 与工具工程</dd></div>
      <div><dt>Building</dt><dd>Three Body Lab / Digital Space</dd></div>
      <div><dt>Reading</dt><dd>Software design & independent web</dd></div>
      <div><dt>Listening</dt><dd>City pop, ambient and anime OST</dd></div>
    </dl>
  </section>

  <section class="writing container" id="writing">
    <div class="section-head"><p class="eyebrow">Selected writing</p><h2>Notes worth<br />keeping.</h2></div>
    <div class="editorial-list">
      {posts.slice(0, 5).map((post, index) => <a href={`/blog/${post.id}/`}>
        <span class="number">0{index + 1}</span>
        <span class="meta">{format(post.data.published)}<br />{post.data.category}</span>
        <span class="copy"><strong>{post.data.title}</strong><small>{post.data.description}</small></span>
        <span class="arrow">↗</span>
      </a>)}
    </div>
  </section>

  <section class="projects container" id="projects">
    <div><p class="eyebrow">Working on</p><h2>Projects as<br />ongoing thoughts.</h2></div>
    <div class="project-list">{projects.map((project) => <article><span>{project.data.status}</span><h3>{project.data.name}</h3><p>{project.data.description}</p><small>{project.data.tech.join(' · ')}</small></article>)}</div>
  </section>

  <footer class="minimal-footer container" id="about"><p>Built slowly, written honestly.</p><div><a href="/rss.xml">RSS</a><a href="/about/">About</a><a href="/prototype/">Design Lab</a></div><span>© 2026 nabunana</span></footer>
</main>

<style>
  :global(.prototype-minimal) { --accent: #697964; }
  main { overflow: hidden; }
  .minimal-hero { min-height: calc(100vh - 76px); display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: auto 1fr auto; padding: 7vh 0 5vh; }
  .index { grid-column: 1/-1; font: .72rem var(--font-mono); letter-spacing: .16em; color: var(--muted); }
  h1 { margin: auto 0; align-self: center; font: 400 clamp(4rem, 10vw, 9.5rem)/.82 var(--font-serif); letter-spacing: -.075em; }
  h1 span { color: var(--accent); }
  .statement { margin: auto 0; align-self: center; font-size: clamp(1.35rem, 2.4vw, 2.5rem); line-height: 1.3; letter-spacing: -.035em; }
  .scroll { grid-column: 2; width: max-content; color: var(--muted); font-size: .8rem; }
  .scroll span { display: inline-block; margin-left: 1.5rem; }
  .currently { display: grid; grid-template-columns: 1fr 3fr; padding: 7rem 0; border-top: 1px solid var(--border); }
  .currently h2 { font: 500 .8rem var(--font-mono); text-transform: uppercase; letter-spacing: .12em; }
  dl { display: grid; grid-template-columns: 1fr 1fr; margin: 0; }
  dl div { padding: 0 0 2rem; }
  dt { color: var(--muted); font-size: .78rem; }
  dd { margin: .35rem 0 0; }
  .writing { padding: 7rem 0; }
  .section-head { display: grid; grid-template-columns: 1fr 3fr; margin-bottom: 5rem; }
  .section-head h2, .projects h2 { margin: 0; font: 400 clamp(3rem, 7vw, 7rem)/.9 var(--font-serif); letter-spacing: -.06em; }
  .editorial-list { border-top: 1px solid var(--text); }
  .editorial-list a { display: grid; grid-template-columns: 60px 155px 1fr 28px; gap: 1rem; align-items: start; padding: 1.6rem 0; border-bottom: 1px solid var(--border); transition: padding .25s var(--ease); }
  .editorial-list a:hover { padding-left: .65rem; }
  .number, .meta { color: var(--muted); font: .7rem/1.6 var(--font-mono); text-transform: uppercase; }
  .copy { display: grid; gap: .35rem; }
  .copy strong { font-size: clamp(1.15rem, 2vw, 1.8rem); letter-spacing: -.025em; }
  .copy small { max-width: 620px; color: var(--muted); }
  .projects { display: grid; grid-template-columns: 1fr 1fr; gap: 8vw; padding: 8rem 0; }
  .project-list { border-top: 1px solid var(--text); }
  .project-list article { padding: 1.5rem 0 2rem; border-bottom: 1px solid var(--border); }
  .project-list span, .project-list small { color: var(--muted); font: .7rem var(--font-mono); text-transform: uppercase; }
  .project-list h3 { margin: .8rem 0 .4rem; font-size: 1.5rem; }
  .project-list p { color: var(--muted); }
  .minimal-footer { display: grid; grid-template-columns: 1fr auto 1fr; gap: 2rem; align-items: center; padding: 3rem 0 8rem; border-top: 1px solid var(--border); color: var(--muted); font-size: .78rem; }
  .minimal-footer div { display: flex; gap: 1.5rem; }.minimal-footer span { text-align: right; }
  @media (max-width: 760px) {
    .minimal-hero { grid-template-columns: 1fr; min-height: 84vh; }
    h1 { margin: 12vh 0 2rem; }.statement { margin: 0; }.scroll { grid-column: 1; margin-top: 4rem; }
    .currently, .section-head, .projects { grid-template-columns: 1fr; gap: 2.5rem; }
    dl { grid-template-columns: 1fr; }.editorial-list a { grid-template-columns: 38px 1fr 20px; }.meta { display: none; }
    .minimal-footer { grid-template-columns: 1fr; }.minimal-footer span { text-align: left; }
  }
</style>
