---
import type { CollectionEntry } from 'astro:content';
interface Props { posts: CollectionEntry<'blog'>[]; projects: CollectionEntry<'projects'>[]; }
const { posts, projects } = Astro.props;
const fmt=(date:Date)=>date.toISOString().slice(0,10);
---
<main id="top">
  <aside class="dev-sidebar">
    <a class="dev-logo" href="/prototype/">W<span>_</span></a>
    <nav><p>workspace</p><a class="active" href="#top"><i>⌂</i> ~/home</a><a href="#writing"><i>≡</i> ~/writing</a><a href="#projects"><i>◇</i> ~/projects</a><a href="#notes"><i>·</i> ~/notes</a><p>system</p><a href="/about/"><i>?</i> ~/about</a><a href="/rss.xml"><i>◌</i> ~/rss</a></nav>
    <div class="sidebar-status"><i></i><span>All systems operational</span><small>Shanghai · UTC+8</small></div>
  </aside>
  <div class="dev-app">
    <header class="command-bar"><span>⌘</span><button type="button" data-search-open><b>Search workspace</b><kbd>Ctrl K</kbd></button><a href="/prototype/">design_lab</a></header>
    <div class="dev-content">
      <section class="terminal-hero"><div class="terminal-top"><span></span><span></span><span></span><small>nabunana@digital-space: ~</small></div><div class="terminal-body"><p><i>❯</i> whoami</p><h1>nabunana<span>.</span></h1><strong>Software engineer building things on the internet.</strong><p class="cmd"><i>❯</i> currently --verbose</p><ul><li><b>●</b><span>building</span>Personal Digital Space with Astro</li><li><b>●</b><span>exploring</span>realtime systems & local agents</li><li><b>●</b><span>writing</span>engineering notes with evidence</li></ul><div class="terminal-actions"><a href="#projects">./view-projects</a><a href="#writing">./read-notes</a></div></div></section>

      <section class="dev-stats" aria-label="站点状态"><article><small>POSTS</small><strong>{String(posts.length).padStart(2,'0')}</strong><span>published entries</span></article><article><small>PROJECTS</small><strong>{String(projects.length).padStart(2,'0')}</strong><span>active builds</span></article><article><small>UPTIME</small><strong>∞</strong><span>still learning</span></article><article><small>STATUS</small><strong class="green">OK</strong><span>ready to ship</span></article></section>

      <section class="dev-section" id="writing"><div class="dev-section-head"><div><p>// latest_writing</p><h2>Recent entries</h2></div><a href="/blog/">view_all() →</a></div><div class="dev-table">{posts.slice(0,6).map(post=><a href={`/blog/${post.id}/`}><time>{fmt(post.data.published)}</time><div><strong>{post.data.title}</strong><span>{post.data.tags.slice(0,3).map(tag=><i>{tag}</i>)}</span></div><small>{post.data.readingTime}</small><b>↗</b></a>)}</div></section>

      <section class="dev-section" id="projects"><div class="dev-section-head"><div><p>// repositories</p><h2>Projects</h2></div><span>sort: updated ↓</span></div><div class="repo-grid">{projects.map(project=><article><header><span>◇</span><b>{project.data.status}</b></header><h3>{project.data.name}</h3><p>{project.data.description}</p><footer><span>{project.data.tech.map(tech=><i>{tech}</i>)}</span><a href="#">README.md ↗</a></footer></article>)}</div></section>

      <section class="activity" id="notes"><div><p>// activity_log</p><h2>What changed lately.</h2></div><ol><li><time>12:20</time><i></i><p><strong>published</strong> TCG card PDF layout notes</p></li><li><time>12:10</time><i></i><p><strong>documented</strong> realtime pipeline architecture</p></li><li><time>11:50</time><i></i><p><strong>shipped</strong> MiniMalloc walkthrough</p></li></ol></section>
      <footer class="dev-footer"><span>nabunana@web:~$ <i class="cursor"></i></span><div><a href="/rss.xml">rss</a><a href="/about/">about</a><a href="/prototype/">lab</a></div><small>EOF · 2026</small></footer>
    </div>
  </div>
</main>

<style>
  :global(.prototype-dev){--bg:#0c0e12;--surface:#12151b;--surface-2:#191d25;--text:#e8edf5;--muted:#7d8798;--accent:#7ee787;--border:#262c36;color-scheme:dark;background-image:linear-gradient(rgb(255 255 255 / 1.5%) 1px,transparent 1px),linear-gradient(90deg,rgb(255 255 255 / 1.5%) 1px,transparent 1px);background-size:32px 32px}
  :global(:root[data-theme='light'] .prototype-dev){--bg:#f5f7fa;--surface:#fff;--surface-2:#edf0f4;--text:#161b22;--muted:#657080;--accent:#16843f;--border:#d9dee7;color-scheme:light}
  main{min-height:100vh;font-family:var(--font-mono)}.dev-sidebar{position:fixed;z-index:20;inset:0 auto 0 0;width:230px;padding:1.4rem;display:flex;flex-direction:column;background:color-mix(in srgb,var(--surface) 93%,transparent);border-right:1px solid var(--border);backdrop-filter:blur(16px)}.dev-logo{font-size:1.6rem;font-weight:900}.dev-logo span{color:var(--accent)}.dev-sidebar nav{display:grid;gap:.3rem;margin-top:3rem}.dev-sidebar nav p{margin:1.2rem .65rem .5rem;color:var(--muted);font-size:.62rem;text-transform:uppercase;letter-spacing:.12em}.dev-sidebar nav a{display:flex;gap:.7rem;padding:.65rem .75rem;border-radius:8px;color:var(--muted);font-size:.76rem}.dev-sidebar nav a:hover,.dev-sidebar nav a.active{background:var(--surface-2);color:var(--text)}.dev-sidebar nav i{width:16px;color:var(--accent);font-style:normal}.sidebar-status{margin-top:auto;padding:1rem;border:1px solid var(--border);border-radius:10px;background:var(--surface);display:grid;grid-template-columns:10px 1fr;gap:.3rem}.sidebar-status i{width:8px;height:8px;border-radius:50%;background:var(--accent);box-shadow:0 0 10px var(--accent)}.sidebar-status span{font-size:.64rem}.sidebar-status small{grid-column:2;color:var(--muted);font-size:.57rem}
  .dev-app{padding-left:230px}.command-bar{position:sticky;z-index:15;top:0;height:64px;padding:0 2rem;display:flex;align-items:center;gap:.7rem;background:color-mix(in srgb,var(--bg) 84%,transparent);border-bottom:1px solid var(--border);backdrop-filter:blur(18px)}.command-bar>span{color:var(--accent)}.command-bar button{height:38px;border:1px solid var(--border);border-radius:7px;background:var(--surface);color:var(--muted);cursor:pointer}.command-bar button:nth-of-type(1){width:min(420px,48vw);display:flex;justify-content:space-between;align-items:center;padding:0 .8rem}.command-bar b{font-weight:400}.command-bar kbd{padding:.2rem .35rem;border:1px solid var(--border);border-radius:4px;font-size:.6rem}.command-bar a{margin-left:auto;color:var(--muted);font-size:.7rem}.dev-content{width:min(calc(100% - 64px),1120px);margin:auto;padding:4rem 0 8rem}.terminal-hero{border:1px solid var(--border);border-radius:12px;background:var(--surface);box-shadow:0 25px 80px rgb(0 0 0 / 18%);overflow:hidden}.terminal-top{height:42px;display:flex;gap:7px;align-items:center;padding:0 1rem;border-bottom:1px solid var(--border);background:var(--surface-2)}.terminal-top>span{width:9px;height:9px;border-radius:50%;background:#ff5f56}.terminal-top>span:nth-child(2){background:#ffbd2e}.terminal-top>span:nth-child(3){background:#27c93f}.terminal-top small{margin:auto;color:var(--muted);font-size:.62rem}.terminal-body{padding:clamp(1.4rem,5vw,4rem)}.terminal-body p{margin:0;color:var(--muted);font-size:.78rem}.terminal-body p i,.cmd i{color:var(--accent);font-style:normal}.terminal-body h1{margin:1rem 0 0;font:800 clamp(4rem,10vw,8.5rem)/.85 var(--font-sans);letter-spacing:-.07em}.terminal-body h1 span{color:var(--accent)}.terminal-body>strong{display:block;margin-top:1.3rem;font:400 clamp(1rem,2vw,1.4rem) var(--font-mono);color:var(--muted)}.terminal-body .cmd{margin-top:3rem}.terminal-body ul{padding:0;list-style:none}.terminal-body li{margin:.6rem 0;font-size:.77rem}.terminal-body li b{color:var(--accent)}.terminal-body li span{display:inline-block;width:95px;margin-left:.7rem;color:#79c0ff}.terminal-actions{display:flex;gap:.7rem;margin-top:2rem}.terminal-actions a{padding:.65rem .85rem;border:1px solid var(--border);border-radius:6px;background:var(--surface-2);font-size:.72rem}.terminal-actions a:first-child{background:var(--accent);color:#07150a;border-color:var(--accent)}
  .dev-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;margin:1.2rem 0 6rem;border:1px solid var(--border);background:var(--border);border-radius:10px;overflow:hidden}.dev-stats article{padding:1.3rem;background:var(--surface)}.dev-stats small{display:block;color:var(--muted);font-size:.58rem}.dev-stats strong{display:block;margin:.45rem 0;font:700 2.2rem var(--font-sans)}.dev-stats strong.green{color:var(--accent)}.dev-stats span{color:var(--muted);font-size:.62rem}.dev-section{margin:7rem 0}.dev-section-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:1.7rem}.dev-section-head p,.activity>div p{margin:0;color:var(--accent);font-size:.67rem}.dev-section-head h2,.activity h2{margin:.25rem 0 0;font:700 clamp(2rem,4vw,3.4rem) var(--font-sans);letter-spacing:-.045em}.dev-section-head>a,.dev-section-head>span{color:var(--muted);font-size:.68rem}
  .dev-table{border-top:1px solid var(--border)}.dev-table>a{display:grid;grid-template-columns:120px 1fr 70px 20px;gap:1rem;align-items:center;padding:1.15rem .5rem;border-bottom:1px solid var(--border);transition:background .15s}.dev-table>a:hover{background:var(--surface)}.dev-table time,.dev-table small{color:var(--muted);font-size:.63rem}.dev-table>a>div{display:grid;gap:.35rem}.dev-table strong{font:650 .88rem var(--font-sans)}.dev-table div span{display:flex;gap:.4rem}.dev-table i,.repo-grid footer i{padding:.14rem .35rem;border:1px solid var(--border);border-radius:4px;color:#79c0ff;font-size:.56rem;font-style:normal}.dev-table>a>b{color:var(--accent)}
  .repo-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem}.repo-grid article{padding:1.4rem;border:1px solid var(--border);border-radius:9px;background:var(--surface);transition:transform .2s,border .2s}.repo-grid article:hover{transform:translateY(-4px);border-color:color-mix(in srgb,var(--accent) 45%,var(--border))}.repo-grid header,.repo-grid footer{display:flex;justify-content:space-between;align-items:center}.repo-grid header>span{color:var(--accent);font-size:1.2rem}.repo-grid header b{color:var(--muted);font-size:.58rem}.repo-grid h3{font:700 1.25rem var(--font-sans)}.repo-grid p{min-height:3rem;color:var(--muted);font: .76rem/1.65 var(--font-sans)}.repo-grid footer>span{display:flex;gap:.35rem}.repo-grid footer a{color:var(--muted);font-size:.58rem}
  .activity{display:grid;grid-template-columns:.8fr 1fr;gap:5vw;margin:8rem 0}.activity ol{margin:0;padding:0;list-style:none}.activity li{display:grid;grid-template-columns:50px 12px 1fr;gap:1rem;min-height:65px}.activity time{color:var(--muted);font-size:.62rem}.activity li i{position:relative;width:8px;height:8px;border-radius:50%;background:var(--accent)}.activity li i::after{content:'';position:absolute;top:8px;left:3px;width:1px;height:56px;background:var(--border)}.activity li:last-child i::after{display:none}.activity li p{margin:-.3rem 0;color:var(--muted);font-size:.7rem}.activity li strong{color:var(--text)}.dev-footer{display:flex;justify-content:space-between;align-items:center;padding-top:2rem;border-top:1px solid var(--border);color:var(--muted);font-size:.65rem}.dev-footer div{display:flex;gap:1rem}.cursor{display:inline-block;width:7px;height:14px;background:var(--accent);animation:blink 1s steps(1) infinite}@keyframes blink{50%{opacity:0}}
  @media(max-width:850px){.dev-sidebar{display:none}.dev-app{padding-left:0}.dev-content{width:calc(100% - 28px)}.command-bar{padding:0 1rem}.dev-stats{grid-template-columns:repeat(2,1fr)}.repo-grid{grid-template-columns:1fr}.activity{grid-template-columns:1fr}.dev-table>a{grid-template-columns:1fr auto}.dev-table time{grid-column:1/-1}.dev-table small{display:none}.dev-footer{align-items:flex-start;flex-direction:column;gap:1rem}}
</style>
