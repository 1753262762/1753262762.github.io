---
import { getCollection } from 'astro:content';
import { lightingPresets } from '../../lib/environment';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
const articleHref = posts[0] ? `/blog/${posts[0].id}/` : '/blog/';
const states = lightingPresets.flatMap((preset) => (['summer', 'night'] as const).map((environment) => ({ preset, environment })));
---

<main class="lighting-comparison" data-lighting-comparison>
  <section class="comparison-hero container">
    <p>ATMOSPHERE STUDY / 03 × 02</p>
    <h1>光落在页面上，<br /><em>而不是站到文字前面。</em></h1>
    <div>
      <p>三套候选都使用同一套真实博客材质变量。点击下方任一状态，页面背景、表面高光、边界和阴影方向会一起变化；选择只用于本次预览，不写入正式偏好。</p>
      <span data-comparison-status aria-live="polite">朝窗 · Dawn Window / Summer</span>
    </div>
  </section>

  <section class="state-matrix container" aria-labelledby="matrix-title">
    <header><span>01</span><p>六种候选状态</p><h2 id="matrix-title">LIGHTING MATRIX</h2></header>
    <div class="matrix-grid">
      {states.map(({ preset, environment }) => (
        <button
          class="state-card"
          type="button"
          data-preview-preset={preset.id}
          data-preview-environment={environment}
          aria-pressed={preset.id === 'dawn-window' && environment === 'summer' ? 'true' : 'false'}
        >
          <span class="state-visual" aria-hidden="true">
            <i></i><i></i><i></i>
            <b>N</b>
            <em></em>
          </span>
          <span class="state-copy">
            <small>{preset.index} / {environment.toUpperCase()}</small>
            <strong>{preset.label} · {preset.englishLabel}</strong>
            <span>{preset.description}</span>
            <em>{environment === 'summer' ? '日光环境' : '月光环境'}</em>
          </span>
        </button>
      ))}
    </div>
  </section>

  <section class="live-preview container" aria-labelledby="preview-title">
    <header><span>02</span><p>实际博客材质</p><h2 id="preview-title">LIVE SURFACES</h2></header>
    <div class="preview-layout">
      <article class="preview-reading">
        <small>文章 / READING</small>
        <h3>清晨的光应该有温度，月色则留给页面一点安静。</h3>
        <p>这段区域使用与正式文章相同的文字、边界和表面变量。光影只在留白、边缘和投影里出现，不改变正文对比度。</p>
        <div><span>#LIGHT</span><span>#LITERATURE</span><span>#SUMMER</span></div>
      </article>
      <aside class="preview-notes">
        <article><small>NOW LISTENING</small><strong>Yorushika</strong><p>表面高光跟随同一光源方向。</p></article>
        <article><small>MOOD</small><strong data-live-environment>Summer</strong><p>慢到几乎察觉不到的呼吸。</p></article>
      </aside>
    </div>
    <nav class="preview-links" aria-label="在实际页面中检查当前光影">
      <a data-preview-link data-base-href="/" href="/?lightingPreset=dawn-window&environment=summer&lightingPreview=1">在首页检查 <span>↗</span></a>
      <a data-preview-link data-base-href="/music/" href="/music/?lightingPreset=dawn-window&environment=summer&lightingPreview=1">在音乐页检查 <span>↗</span></a>
      <a data-preview-link data-base-href={articleHref} href={`${articleHref}?lightingPreset=dawn-window&environment=summer&lightingPreview=1`}>在文章页检查 <span>↗</span></a>
    </nav>
  </section>

  <footer class="comparison-footer container">
    <p>这是一页开发阶段比较器。最终站点只保留被选中的一套光影，不向访客提供三套风格选择。</p>
    <a href="/prototype/acg/">返回 ACG 原型 ↗</a>
  </footer>
</main>

<script>
  import { DEFAULT_LIGHTING_PRESET, lightingPresetIds, lightingPresets, type EnvironmentMode, type LightingPreset } from '../../lib/environment';

  let comparisonAbort: AbortController | undefined;
  const isPreset = (value: string | null): value is LightingPreset => lightingPresetIds.includes(value as LightingPreset);
  const isEnvironment = (value: string | null): value is EnvironmentMode => value === 'summer' || value === 'night';

  const setupLightingComparison = () => {
    comparisonAbort?.abort();
    comparisonAbort = new AbortController();
    const { signal } = comparisonAbort;
    const comparison = document.querySelector<HTMLElement>('[data-lighting-comparison]');
    if (!comparison) return;
    const root = document.documentElement;
    const buttons = [...comparison.querySelectorAll<HTMLButtonElement>('[data-preview-preset]')];
    const status = comparison.querySelector<HTMLElement>('[data-comparison-status]');
    const liveEnvironment = comparison.querySelector<HTMLElement>('[data-live-environment]');
    const params = new URL(location.href).searchParams;

    const activate = (preset: LightingPreset, environment: EnvironmentMode) => {
      buttons.forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.previewPreset === preset && button.dataset.previewEnvironment === environment));
      });
      const definition = lightingPresets.find((item) => item.id === preset) ?? lightingPresets[0];
      if (status) status.textContent = `${definition.label} · ${definition.englishLabel} / ${environment === 'summer' ? 'Summer' : 'Night'}`;
      if (liveEnvironment) liveEnvironment.textContent = environment === 'summer' ? 'Summer' : 'Night';
      comparison.querySelectorAll<HTMLAnchorElement>('[data-preview-link]').forEach((link) => {
        const target = new URL(link.dataset.baseHref || '/', location.origin);
        target.searchParams.set('lightingPreset', preset);
        target.searchParams.set('environment', environment);
        target.searchParams.set('lightingPreview', '1');
        link.href = `${target.pathname}${target.search}`;
      });
      window.dispatchEvent(new CustomEvent('nabunana:environment-preview', { detail: { preset, environment } }));
    };

    buttons.forEach((button) => button.addEventListener('click', () => {
      const preset = button.dataset.previewPreset ?? null;
      const environment = button.dataset.previewEnvironment ?? null;
      if (isPreset(preset) && isEnvironment(environment)) activate(preset, environment);
    }, { signal }));

    const initialPreset = isPreset(params.get('lightingPreset')) ? params.get('lightingPreset') as LightingPreset : DEFAULT_LIGHTING_PRESET;
    const initialEnvironment = isEnvironment(params.get('environment')) ? params.get('environment') as EnvironmentMode : 'summer';
    root.dataset.lightingPreset = initialPreset;
    activate(initialPreset, initialEnvironment);
  };

  document.addEventListener('astro:page-load', setupLightingComparison);
  setupLightingComparison();
</script>

<style>
  :global(.lighting-lab-page){--bg:#f3f9f7;--surface:#fbfdfc;--surface-2:#eaf3f0;--text:#173b3a;--strong:#102e2d;--muted:#64817f;--accent:#3dafa5;--accent-deep:#216e69;--border:rgb(39 108 103 / 14%);background:var(--bg);color:var(--text)}
  :global(:root[data-theme='dark'] .lighting-lab-page){--bg:#102724;--surface:#18332f;--surface-2:#1e3b36;--text:#e7f0ed;--strong:#f3f8f6;--muted:#9eb3ae;--accent:#78c5bb;--accent-deep:#58aaa0;--border:rgb(174 222 215 / 15%)}
  :global(.lighting-lab-page .site-player){display:none}
  .lighting-comparison{min-height:100vh;color:var(--text);overflow:clip}.comparison-hero{display:grid;grid-template-columns:150px 1fr minmax(260px,380px);gap:2rem;align-items:end;padding:clamp(5rem,9vw,9rem) 0;border-bottom:1px solid var(--border)}.comparison-hero>p{align-self:start;margin:0;color:var(--accent);font:.58rem var(--font-mono);letter-spacing:.14em}.comparison-hero h1{margin:0;color:var(--strong);font:500 clamp(3.1rem,6.2vw,6.8rem)/.94 var(--font-serif);letter-spacing:-.055em}.comparison-hero h1 em{color:var(--accent);font-style:normal}.comparison-hero>div>p{margin:0;color:var(--muted);font-size:.78rem;line-height:1.8}.comparison-hero>div>span{display:block;margin-top:1.4rem;padding-top:.8rem;border-top:1px solid var(--border);color:var(--accent-deep);font:.58rem var(--font-mono);letter-spacing:.08em}
  .state-matrix,.live-preview{padding:clamp(5rem,9vw,9rem) 0}.state-matrix>header,.live-preview>header{display:grid;grid-template-columns:80px 170px 1fr;align-items:end;padding-bottom:1.2rem;margin-bottom:3rem;border-bottom:1px solid var(--border)}.state-matrix>header>span,.live-preview>header>span{color:var(--accent);font:.62rem var(--font-mono)}.state-matrix>header p,.live-preview>header p{margin:0;color:var(--muted);font:.62rem var(--font-mono);letter-spacing:.1em}.state-matrix h2,.live-preview h2{margin:0;color:var(--strong);font:500 clamp(2.2rem,4.6vw,4.8rem)/.9 var(--font-serif);letter-spacing:-.05em}
  .matrix-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;background:var(--border);border:1px solid var(--border)}.state-card{min-width:0;padding:0;border:0;background:var(--surface);color:inherit;text-align:left;cursor:pointer}.state-card[aria-pressed='true']{outline:2px solid var(--accent);outline-offset:-2px}.state-visual{position:relative;display:block;aspect-ratio:16/10;overflow:hidden;background:#f4faf8}.state-visual::before,.state-visual::after{content:'';position:absolute;pointer-events:none}.state-visual::before{inset:-30%;opacity:.76;animation:comparison-light-drift 18s ease-in-out infinite alternate;will-change:translate,scale}.state-card:nth-child(even) .state-visual::before{animation-delay:-9s;animation-duration:22s}.state-visual::after{inset:0;background:linear-gradient(145deg,rgb(255 255 255/.32),transparent 30%,rgb(7 24 22/.06))}.state-visual i{position:absolute;z-index:2;display:block;height:1px;background:rgb(26 72 68/.17)}.state-visual i:nth-child(1){left:10%;right:10%;top:20%}.state-visual i:nth-child(2){left:10%;right:18%;top:38%}.state-visual i:nth-child(3){left:10%;width:45%;top:48%}.state-visual b{position:absolute;z-index:2;left:10%;bottom:12%;display:grid;place-items:center;width:27px;height:27px;border:1px solid rgb(24 85 80/.28);border-radius:50%;color:#216e69;font:500 .65rem var(--font-serif)}.state-visual em{position:absolute;z-index:2;left:calc(10% + 37px);bottom:calc(12% + 13px);width:42px;border-top:1px solid rgb(24 85 80/.24);transform:rotate(-8deg)}
  .state-card[data-preview-environment='night'] .state-visual{background:#102724}.state-card[data-preview-environment='night'] .state-visual i{background:rgb(210 235 232/.14)}.state-card[data-preview-environment='night'] .state-visual b{border-color:rgb(174 222 215/.25);color:#a0ddd5}.state-card[data-preview-environment='night'] .state-visual em{border-color:rgb(174 222 215/.22)}.state-card[data-preview-preset='dawn-window'][data-preview-environment='summer'] .state-visual::before{background:radial-gradient(circle at 8% 4%,rgb(255 210 132/.92),rgb(255 226 174/.24) 28%,transparent 59%)}.state-card[data-preview-preset='dawn-window'][data-preview-environment='night'] .state-visual::before{background:radial-gradient(circle at 90% 7%,rgb(214 232 230/.48),rgb(151 201 194/.1) 32%,transparent 60%),linear-gradient(78deg,transparent 42%,rgb(205 229 225/.08) 43% 49%,transparent 50%)}.state-card[data-preview-preset='pine-shadow'][data-preview-environment='summer'] .state-visual::before{background:radial-gradient(circle at 28% 5%,rgb(255 222 158/.8),transparent 48%),repeating-radial-gradient(ellipse at 78% 10%,rgb(35 75 57/.13) 0 5px,transparent 7px 22px);transform:rotate(-8deg)}.state-card[data-preview-preset='pine-shadow'][data-preview-environment='night'] .state-visual::before{background:radial-gradient(circle at 78% 8%,rgb(205 229 225/.42),transparent 46%),repeating-radial-gradient(ellipse at 18% 4%,rgb(10 34 32/.24) 0 5px,transparent 7px 23px);transform:rotate(8deg)}.state-card[data-preview-preset='silver-river'][data-preview-environment='summer'] .state-visual::before{background:radial-gradient(circle at 18% 12%,rgb(255 215 156/.78),transparent 45%),linear-gradient(155deg,transparent 22%,rgb(177 151 197/.18) 48%,transparent 65%)}.state-card[data-preview-preset='silver-river'][data-preview-environment='night'] .state-visual::before{background:radial-gradient(circle at 18% 20%,rgb(214 232 230/.42) 0 1px,transparent 2px),radial-gradient(circle at 65% 12%,rgb(214 232 230/.38) 0 1px,transparent 2px),linear-gradient(165deg,transparent 24%,rgb(202 225 221/.18) 48%,rgb(132 165 166/.08) 55%,transparent 68%)}
  .state-card[data-preview-preset='dawn-window'] .state-visual::before{inset:-8%;background:linear-gradient(128deg,rgb(255 214 176/.46),transparent 42%);mask-image:linear-gradient(128deg,#000 0 42%,transparent 86%);animation-duration:67s}.state-card[data-preview-preset='dawn-window'] .state-visual::after{background:linear-gradient(90deg,transparent 13%,rgb(42 78 72/.2) 14% 15.2%,transparent 16% 38%,rgb(42 78 72/.18) 39% 40.5%,transparent 41% 70%,rgb(42 78 72/.16) 71% 72%,transparent 73%),linear-gradient(180deg,transparent 21%,rgb(42 78 72/.12) 22% 23%,transparent 24% 57%,rgb(42 78 72/.1) 58% 59%,transparent 60%)}.state-card[data-preview-preset='dawn-window'] .state-visual :is(b,em){opacity:0}.state-card[data-preview-preset='dawn-window'][data-preview-environment='night'] .state-visual::before{background:radial-gradient(ellipse 72% 35% at 88% 8%,rgb(210 228 226/.46),rgb(210 228 226/.12) 40%,transparent 75%);mask-image:linear-gradient(228deg,#000 0 42%,transparent 90%)}.state-card[data-preview-preset='dawn-window'][data-preview-environment='night'] .state-visual::after{background:linear-gradient(90deg,transparent 13%,rgb(210 228 226/.12) 14% 15.2%,transparent 16% 38%,rgb(210 228 226/.1) 39% 40.5%,transparent 41% 70%,rgb(210 228 226/.09) 71% 72%,transparent 73%),linear-gradient(180deg,transparent 21%,rgb(210 228 226/.08) 22% 23%,transparent 24% 57%,rgb(210 228 226/.07) 58% 59%,transparent 60%)}
  .state-copy{display:block;padding:1.2rem 1.25rem 1.4rem}.state-copy small,.state-copy span,.state-copy em{display:block}.state-copy small{color:var(--accent);font:.55rem var(--font-mono);letter-spacing:.1em}.state-copy strong{display:block;margin:.55rem 0;color:var(--strong);font:500 1.2rem var(--font-serif)}.state-copy span{color:var(--text);font:.78rem var(--font-serif)}.state-copy em{margin-top:.25rem;color:var(--muted);font:normal .52rem var(--font-mono)}
  .live-preview{border-top:1px solid var(--border)}.preview-layout{display:grid;grid-template-columns:1.45fr .8fr;gap:1px;background:var(--border);border:1px solid var(--border)}.preview-reading,.preview-notes article{background-color:color-mix(in srgb,var(--surface) 90%,transparent);background-image:linear-gradient(var(--lighting-angle),color-mix(in srgb,rgb(var(--lighting-highlight)) 8%,transparent),transparent 34%);box-shadow:inset 0 1px 0 color-mix(in srgb,rgb(var(--lighting-highlight)) 13%,transparent)}.preview-reading{padding:clamp(2rem,5vw,5rem)}.preview-reading small,.preview-notes small{color:var(--accent);font:.56rem var(--font-mono);letter-spacing:.1em}.preview-reading h3{max-width:780px;margin:2rem 0;color:var(--strong);font:500 clamp(2rem,4vw,4.3rem)/1.08 var(--font-serif);letter-spacing:-.04em}.preview-reading p{max-width:650px;color:var(--muted);font:1rem/1.8 var(--font-serif)}.preview-reading>div{display:flex;gap:.8rem;margin-top:3rem;color:var(--muted);font:.55rem var(--font-mono)}.preview-notes{display:grid;grid-template-rows:1fr 1fr;gap:1px}.preview-notes article{padding:2rem}.preview-notes strong{display:block;margin:2.5rem 0 .7rem;color:var(--strong);font:500 2rem var(--font-serif)}.preview-notes p{margin:0;color:var(--muted);font-size:.72rem}.preview-links{display:grid;grid-template-columns:repeat(3,1fr);margin-top:1px;background:var(--border);gap:1px}.preview-links a{display:flex;justify-content:space-between;padding:1rem 1.2rem;background:var(--surface);color:var(--muted);font-size:.68rem}.preview-links a:hover{color:var(--accent-deep)}.preview-links span{color:var(--accent)}
  .comparison-footer{display:flex;justify-content:space-between;gap:2rem;padding:2.5rem 0 9rem;border-top:1px solid var(--border);color:var(--muted);font-size:.68rem}.comparison-footer p{max-width:680px;margin:0}.comparison-footer a{color:var(--accent-deep)}
  @keyframes comparison-light-drift{0%{translate:-7px -3px;scale:.99}50%{scale:1.018}100%{translate:10px 6px;scale:1.008}}
  @media(max-width:900px){.comparison-hero{grid-template-columns:100px 1fr}.comparison-hero>div{grid-column:2}.matrix-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.preview-layout{grid-template-columns:1fr}.preview-notes{grid-template-columns:1fr 1fr;grid-template-rows:auto}.preview-links{grid-template-columns:1fr}}
  @media(max-width:620px){.comparison-hero{display:block;padding-top:4rem}.comparison-hero>p{margin-bottom:1.5rem}.comparison-hero>div{margin-top:2rem}.state-matrix>header,.live-preview>header{grid-template-columns:1fr;gap:.6rem}.matrix-grid{grid-template-columns:1fr}.preview-notes{grid-template-columns:1fr}.comparison-footer{display:block}.comparison-footer a{display:inline-block;margin-top:1rem}}
  @media(prefers-reduced-motion:reduce){.state-card,.state-visual::before{transition:none}}
</style>
