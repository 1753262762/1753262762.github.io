---
import type { CollectionEntry } from 'astro:content';
import WindWaveMotif from './WindWaveMotif.astro';
import { albumStartIndexes, musicAlbums } from '../../data/music';

interface Props {
  posts: CollectionEntry<'blog'>[];
  projects: CollectionEntry<'projects'>[];
  notes: CollectionEntry<'notes'>[];
  prototype?: boolean;
}

const { posts, projects, notes, prototype = true } = Astro.props;
const musicHref = prototype ? '/prototype/acg/music/' : '/music/';
const watching = [
  { title: '葬送のフリーレン', meta: 'Frieren', progress: 82, status: 'Watching', image: '/media/anime/frieren.webp', source: 'https://frieren-anime.jp/special/gallery/' },
  { title: 'ぼっち・ざ・ろっく！', meta: 'Bocchi the Rock!', progress: 100, status: 'Finished', image: '/media/anime/bocchi-the-rock.webp', source: 'https://bocchi.rocks/tv/' },
  { title: '86 —Eighty Six—', meta: 'Anime note', progress: 64, status: 'Watching', image: '/media/anime/eighty-six.webp', source: 'https://anime-86.com/' },
];
const formatDate = (date: Date) => new Intl.DateTimeFormat('zh-CN', { month: '2-digit', day: '2-digit' }).format(date);
---

<main id="top" class="acg-home" data-acg-root>
  <section class="acg-hero container" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="season"><span data-environment-season>夏 / SUMMER</span><b>2026</b></p>
      <h1 id="hero-title">写到天亮，<br /><em>也没关系。</em></h1>
      <p class="hero-sub">Notes, code, music,<br />and fragments of summer.</p>
      <div class="identity"><strong>nabunana</strong><span>Developer</span><span>Writer</span><span>Music Listener</span></div>
      <div class="actions">
        <a class="acg-button" href="#writing">读一些文字 <span>↗</span></a>
        <a class="text-link" href="#currently">从这里开始 <span>↓</span></a>
      </div>
    </div>
    <WindWaveMotif />
    <p class="hero-index" aria-hidden="true">01 / 09</p>
  </section>

  <section class="currently container" id="currently" aria-labelledby="currently-title">
    <header class="section-head"><p><span>01</span> 最近のこと</p><h2 id="currently-title">CURRENTLY</h2></header>
    <div class="currently-grid">
      <article><small>今聴いている / LISTENING</small><strong>Yorushika</strong><p>最近的音乐片段，没有伪装成播放器。</p></article>
      <article><small>今見ている / WATCHING</small><strong>葬送のフリーレン</strong><p>把旅途、时间和告别慢慢看完。</p></article>
      <article><small>制作中 / BUILDING</small><strong>Personal Blog</strong><p>Astro、内容系统与属于自己的视觉语言。</p></article>
      <article><small>読んでいる / READING</small><strong>技术文章与随笔</strong><p>在工程实践之外，留一点给文字。</p></article>
    </div>
  </section>

  <section class="writing container" id="writing" aria-labelledby="writing-title">
    <header class="section-head"><p><span>02</span> 文章</p><h2 id="writing-title">LATEST WRITING</h2><a href="/blog/">全部文章 ↗</a></header>
    <div class="editorial-list">
      {posts.slice(0, 5).map((post) => (
        <a href={`/blog/${post.id}/`}>
          <time datetime={post.data.published.toISOString()}>{formatDate(post.data.published)}</time>
          <small>{post.data.category}</small>
          <div><h3>{post.data.title}</h3><p>{post.data.description}</p></div>
          <span aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>

  <section class="music" id="music" aria-labelledby="music-title">
    <div class="container music-shell">
      <header class="section-head inverse"><p><span>03</span> 音楽</p><h2 id="music-title">SOUNDS AFTER DARK</h2><a href={musicHref}>进入音乐页 ↗</a></header>
      <div class="album-gallery" aria-label="七张专辑循环唱片廊" aria-roledescription="carousel" data-album-carousel>
        {musicAlbums.map((album, index) => (
          <button type="button" class="album-card" data-album-index={index} data-play-index={albumStartIndexes[album.slug]} aria-label={`播放专辑 ${album.title}`} tabindex={index === 0 ? 0 : -1}>
            <span class="album-cover"><img src={album.cover} alt={`${album.title} 专辑封面`} loading={index === 0 ? 'eager' : 'lazy'} /><i aria-hidden="true"></i><b aria-hidden="true">▶</b></span>
            <span class="album-number">{String(index + 1).padStart(2, '0')} / {album.year}</span>
            <strong>{album.title}</strong>
            <small>{album.artist} · {album.tracks.length} TRACKS</small>
          </button>
        ))}
        <span class="carousel-status" data-carousel-status aria-live="polite">当前专辑：{musicAlbums[0].title}</span>
      </div>
      <p class="gallery-note"><span>AUTO CRUISE</span> 拖动唱片廊，或使用方向键浏览七张专辑。点击封面从第一首开始。</p>
    </div>
  </section>

  <section class="notes container" id="notes" aria-labelledby="notes-title">
    <header class="section-head"><p><span>04</span> 夏の記録</p><h2 id="notes-title">NOTES</h2></header>
    <div class="notes-row">
      {notes.map((note) => <article><time>{formatDate(note.data.created)}</time><h3>{note.data.title}</h3><p>一则正在生长的短笔记。</p></article>)}
      <article class="note-placeholder"><time>—</time><h3>风吹过海面的时候</h3><p>这里会继续收纳短句、灵感和没有归类的夏日片段。</p></article>
    </div>
  </section>

  <section class="projects container" id="projects" aria-labelledby="projects-title">
    <header class="section-head"><p><span>05</span> 作品</p><h2 id="projects-title">PROJECTS</h2><a href="/projects/">项目归档 ↗</a></header>
    <div class="project-list">
      {projects.map((project, index) => <article><span>{String(index + 1).padStart(2, '0')}</span><div><small>{project.data.tech.slice(0, 3).join(' / ')}</small><h3>{project.data.name}</h3><p>{project.data.description}</p></div><b>{project.data.status}</b></article>)}
    </div>
  </section>

  <section class="watching container" id="watching" aria-labelledby="watching-title">
    <header class="section-head"><p><span>06</span> 今見ている</p><h2 id="watching-title">WATCHING</h2></header>
    <div class="watching-grid">
      {watching.map((item, index) => <article><a class="watch-cover" href={item.source} target="_blank" rel="noopener" aria-label={`${item.title} 官方视觉图来源`}><img src={item.image} alt={`${item.title} 官方宣传视觉图`} width="900" height="1200" loading="lazy" /><span>{String(index + 1).padStart(2, '0')}</span><i>OFFICIAL ↗</i></a><small>{item.meta}</small><h3>{item.title}</h3><div class="watch-progress"><i style={`width:${item.progress}%`}></i></div><footer><span>{item.progress}%</span><b>{item.status}</b></footer></article>)}
    </div>
  </section>

  <section class="fragments" id="fragments" aria-labelledby="fragments-title">
    <div class="container"><header class="section-head inverse"><p><span>07</span> 残像</p><h2 id="fragments-title">FRAGMENTS</h2></header><div class="fragment-grid" aria-label="未来的摄影与视觉片段占位"><div><span>SKY / 17:42</span></div><div><span>SEA / AFTER RAIN</span></div><div><span>NIGHT / 02:14</span></div></div><p class="fragment-note">Photography will live here — 保留空间，等待真实照片，而不是用版权插画填满它。</p></div>
  </section>

  <section class="about container" id="about"><p class="about-kicker">08 / ABOUT THIS PLACE</p><h2>一个喜欢写代码、听音乐，<br />也想认真保存生活的人。</h2><p>这里不是粉色二次元模板，也不是音乐品牌的复刻。它只是 nabunana 的个人数字空间：技术文章、项目、ACG、音乐，以及一些没来得及命名的记忆。</p><a class="text-link" href="/about/">关于我与这个网站 <span>↗</span></a></section>

  <footer class="acg-footer"><WindWaveMotif compact label="Footer sea horizon" /><div class="container footer-copy"><div><strong>また、どこかで。</strong><p>See you somewhere on the internet.</p></div><div><span>nabunana © 2026</span><nav aria-label="页脚导航"><a href="/blog/">Writing</a><a href="/music/">Music</a><a href="/projects/">Projects</a><a href="https://github.com/1753262762" target="_blank" rel="me noopener">GitHub</a><a href="/rss.xml">RSS</a></nav></div></div></footer>

</main>

<script>
  let acgHomeAbort: AbortController | undefined;
  const bindAcgHome = () => {
    acgHomeAbort?.abort();
    acgHomeAbort = new AbortController();
    const { signal } = acgHomeAbort;
    const root = document.querySelector<HTMLElement>('[data-acg-root]');
    if (!root) return;
    const albumRail = document.querySelector<HTMLElement>('[data-album-carousel]');
    if (albumRail) {
      const cards = [...albumRail.querySelectorAll<HTMLButtonElement>('[data-album-index]')];
      const status = albumRail.querySelector<HTMLElement>('[data-carousel-status]');
      const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
      let position = 0;
      let velocity = 0;
      let stride = 240;
      let mode: 'cruise' | 'drag' | 'inertia' | 'settle' | 'pause' = reducedMotion.matches ? 'pause' : 'cruise';
      let settleTarget = 0;
      let pauseUntil = 0;
      let hovered = false;
      let dragging = false;
      let dragged = false;
      let suppressClick = false;
      let pointerStart = 0;
      let lastPointerX = 0;
      let lastPointerAt = 0;
      let frame = 0;
      let lastFrameAt = performance.now();
      let announcedIndex = -1;

      const wrapIndex = (value: number) => ((value % cards.length) + cards.length) % cards.length;
      const updateStride = () => {
        const cardWidth = cards[0]?.getBoundingClientRect().width || 280;
        stride = Math.min(cardWidth * .88, albumRail.clientWidth * .34);
      };
      const renderCarousel = () => {
        if (!cards.length) return;
        const progress = position / stride;
        const nearest = wrapIndex(Math.round(progress));
        cards.forEach((card, index) => {
          let distance = index - progress;
          distance = ((distance + cards.length / 2) % cards.length + cards.length) % cards.length - cards.length / 2;
          const depth = Math.abs(distance);
          const x = distance * stride;
          const y = Math.min(depth * depth * 4, 32);
          const z = -Math.min(depth * 78, 235);
          const rotate = Math.max(-18, Math.min(18, distance * -7));
          const opacity = Math.max(0, Math.min(1, 1.12 - Math.max(0, depth - 1.7) * .58));
          const brightness = Math.max(.48, 1 - depth * .13);
          card.style.transform = `translate3d(-50%, 0, 0) translate3d(${x}px, ${y}px, ${z}px) rotateY(${rotate}deg)`;
          card.style.opacity = String(opacity);
          card.style.filter = `brightness(${brightness}) saturate(${Math.max(.72, 1 - depth * .06)})`;
          card.style.zIndex = String(20 - Math.round(depth * 3));
          card.style.pointerEvents = opacity < .08 ? 'none' : 'auto';
          const current = index === nearest;
          card.tabIndex = current ? 0 : -1;
          if (current) card.setAttribute('aria-current', 'true');
          else card.removeAttribute('aria-current');
        });
        if (nearest !== announcedIndex) {
          announcedIndex = nearest;
          if (status) status.textContent = `当前专辑：${cards[nearest]?.querySelector('strong')?.textContent || ''}`;
        }
      };
      const settleOn = (target: number) => {
        settleTarget = target;
        mode = reducedMotion.matches ? 'pause' : 'settle';
        if (reducedMotion.matches) {
          position = target;
          velocity = 0;
          renderCarousel();
        }
      };
      const tick = (now: number) => {
        const dt = Math.min((now - lastFrameAt) / 1000, .034);
        lastFrameAt = now;
        if (mode === 'cruise') {
          const targetSpeed = hovered ? 4 : 10;
          velocity += (targetSpeed - velocity) * (1 - Math.exp(-dt / 1.2));
          position += velocity * dt;
        } else if (mode === 'inertia') {
          position += velocity * dt;
          velocity *= Math.exp(-dt / .72);
          if (Math.abs(velocity) < 15) settleOn(Math.round(position / stride) * stride);
        } else if (mode === 'settle') {
          const acceleration = (settleTarget - position) * 28 - velocity * 10.6;
          velocity += acceleration * dt;
          position += velocity * dt;
          if (Math.abs(settleTarget - position) < .45 && Math.abs(velocity) < 1.2) {
            position = settleTarget;
            velocity = 0;
            pauseUntil = now + 800;
            mode = 'pause';
          }
        } else if (mode === 'pause' && !reducedMotion.matches && now >= pauseUntil) {
          mode = 'cruise';
        }
        renderCarousel();
        frame = requestAnimationFrame(tick);
      };

      updateStride();
      renderCarousel();
      frame = requestAnimationFrame(tick);
      signal.addEventListener('abort', () => cancelAnimationFrame(frame), { once: true });
      window.addEventListener('resize', () => {
        const active = position / stride;
        updateStride();
        position = active * stride;
        renderCarousel();
      }, { signal });
      albumRail.addEventListener('pointerenter', () => { hovered = true; }, { signal });
      albumRail.addEventListener('pointerleave', () => { hovered = false; }, { signal });
      albumRail.addEventListener('pointerdown', (event) => {
        if (event.pointerType === 'mouse' && event.button !== 0) return;
        dragging = true;
        dragged = false;
        pointerStart = event.clientX;
        lastPointerX = event.clientX;
        lastPointerAt = event.timeStamp;
        velocity = 0;
        mode = 'drag';
        albumRail.classList.add('is-dragging');
        albumRail.setPointerCapture(event.pointerId);
      }, { signal });
      albumRail.addEventListener('pointermove', (event) => {
        if (!dragging) return;
        const dx = event.clientX - lastPointerX;
        const elapsed = Math.max(event.timeStamp - lastPointerAt, 1) / 1000;
        if (Math.abs(event.clientX - pointerStart) > 5) dragged = true;
        position -= dx;
        const sampledVelocity = -dx / elapsed;
        velocity = velocity * .72 + sampledVelocity * .28;
        lastPointerX = event.clientX;
        lastPointerAt = event.timeStamp;
        renderCarousel();
      }, { signal });
      const finishDrag = (event: PointerEvent) => {
        if (!dragging) return;
        dragging = false;
        albumRail.classList.remove('is-dragging');
        if (albumRail.hasPointerCapture(event.pointerId)) albumRail.releasePointerCapture(event.pointerId);
        if (dragged) {
          suppressClick = true;
          velocity = Math.max(-1100, Math.min(1100, velocity));
          if (reducedMotion.matches) settleOn(Math.round(position / stride) * stride);
          else mode = Math.abs(velocity) >= 15 ? 'inertia' : 'settle';
          if (mode === 'settle') settleTarget = Math.round(position / stride) * stride;
        } else {
          mode = reducedMotion.matches ? 'pause' : 'cruise';
        }
      };
      albumRail.addEventListener('pointerup', finishDrag, { signal });
      albumRail.addEventListener('pointercancel', finishDrag, { signal });
      albumRail.addEventListener('click', (event) => {
        if (!suppressClick) return;
        event.preventDefault();
        event.stopPropagation();
        suppressClick = false;
      }, { capture: true, signal });
      albumRail.addEventListener('wheel', (event) => {
        if (Math.abs(event.deltaY) <= Math.abs(event.deltaX)) return;
        event.preventDefault();
        const delta = event.deltaMode === WheelEvent.DOM_DELTA_LINE ? event.deltaY * 16 : event.deltaY;
        position += delta * .45;
        if (reducedMotion.matches) settleOn(Math.round(position / stride) * stride);
        else {
          velocity = Math.max(-1100, Math.min(1100, velocity + delta * 5));
          mode = 'inertia';
        }
      }, { passive: false, signal });
      albumRail.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
        event.preventDefault();
        const direction = event.key === 'ArrowRight' ? 1 : -1;
        const targetIndex = Math.round(position / stride) + direction;
        settleOn(targetIndex * stride);
        cards[wrapIndex(targetIndex)]?.focus({ preventScroll: true });
      }, { signal });
      reducedMotion.addEventListener('change', () => {
        velocity = 0;
        settleOn(Math.round(position / stride) * stride);
      }, { signal });
    }
    document.querySelectorAll<HTMLButtonElement>('[data-play-index]').forEach((button) => button.addEventListener('click', () => {
      const index = Number.parseInt(button.dataset.playIndex || '0', 10);
      window.dispatchEvent(new CustomEvent('nabunana:play-track', { detail: index }));
    }, { signal }));
    if (matchMedia('(pointer:fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const art = document.querySelector<HTMLElement>('.acg-hero .wind-wave');
      document.querySelector('.acg-hero')?.addEventListener('pointermove', (event) => {
        if (!(event instanceof PointerEvent) || !art) return;
        const bounds = (event.currentTarget as HTMLElement).getBoundingClientRect();
        const x = ((event.clientX - bounds.left) / bounds.width - .5) * 6;
        const y = ((event.clientY - bounds.top) / bounds.height - .5) * 4;
        art.style.transform = `translate3d(${x}px, ${y}px, 0)`;
      }, { signal });
    }
  };
  document.addEventListener('astro:page-load', bindAcgHome);
  bindAcgHome();
</script>

<style>
  :global(.prototype-acg), :global(.acg-site) { --bg:#f5fbfa;--surface:#fff;--surface-2:#edf7f5;--text:#173b3a;--strong:#102e2d;--muted:#64817f;--accent:#3dafa5;--accent-soft:#68c5bb;--accent-deep:#216e69;--sky:#83c9d7;--border:rgb(39 108 103 / 14%);background:var(--bg);color:var(--text); }
  :global(:root[data-theme='dark'] .prototype-acg), :global(:root[data-theme='dark'] .acg-site) { --bg:#102724;--surface:#18332f;--surface-2:#1e3b36;--text:#e7f0ed;--strong:#f3f8f6;--muted:#9eb3ae;--accent:#78c5bb;--accent-soft:#a0ddd5;--accent-deep:#58aaa0;--sky:#72aeb3;--border:rgb(174 222 215 / 15%); }
  .acg-home{overflow:clip;background:transparent;color:var(--text);transition:color .35s ease}
  .acg-home::before{content:'';position:fixed;z-index:20;inset:0;pointer-events:none;opacity:.018;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 140 140' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.82' numOctaves='2' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E")}
  .acg-hero{position:relative;min-height:calc(100svh - 72px);display:grid;grid-template-columns:1fr 1fr;align-items:stretch;border-bottom:1px solid var(--border)}.hero-copy{align-self:center;padding:6rem clamp(2rem,6vw,6rem) 7rem 0}.season{display:flex;width:max-content;gap:1rem;margin:0 0 4rem;color:var(--muted);font:.68rem var(--font-mono);letter-spacing:.16em}.season span{color:var(--accent-deep)}.season b{font-weight:500}
  h1{margin:0;color:var(--strong);font:500 clamp(3.8rem,7.6vw,8.2rem)/.98 var(--font-serif);letter-spacing:-.065em}.hero-copy h1 em{color:var(--accent);font-style:normal}.hero-sub{margin:2.5rem 0;color:var(--muted);font:400 clamp(1rem,1.6vw,1.25rem)/1.65 var(--font-serif);letter-spacing:.01em}.identity{display:flex;flex-wrap:wrap;gap:.55rem 1.1rem;align-items:center;margin:2.5rem 0;color:var(--muted);font-size:.72rem}.identity strong{color:var(--text);font:600 1.1rem var(--font-serif);padding-right:1.1rem;border-right:1px solid var(--border)}
  .actions{display:flex;align-items:center;gap:1.5rem;margin-top:3rem}.acg-button{display:inline-flex;justify-content:space-between;align-items:center;gap:2rem;min-width:175px;padding:.8rem 1rem;border-radius:6px;background:var(--accent-deep);color:#f5fffd;font-size:.78rem;transition:transform .25s var(--ease),background .25s}.acg-button:hover{transform:translateY(-2px);background:var(--accent)}.text-link{display:inline-flex;gap:.65rem;align-items:center;color:var(--muted);font-size:.75rem}.text-link span{color:var(--accent)}.hero-index{position:absolute;right:1rem;bottom:1rem;margin:0;color:var(--muted);font:.58rem var(--font-mono);letter-spacing:.12em}
  section:not(.music,.fragments),.about{padding-block:clamp(6rem,10vw,10rem)}.section-head{display:grid;grid-template-columns:190px 1fr auto;align-items:end;margin-bottom:clamp(2.5rem,5vw,5rem);border-bottom:1px solid var(--border);padding-bottom:1.25rem}.section-head p{margin:0;color:var(--muted);font:.7rem var(--font-mono);letter-spacing:.12em}.section-head p span{color:var(--accent);margin-right:1rem}.section-head h2{margin:0;color:var(--strong);font:500 clamp(2rem,4.2vw,4.6rem)/.9 var(--font-serif);letter-spacing:-.045em}.section-head>a{color:var(--muted);font-size:.7rem}.section-head>a:hover{color:var(--accent)}
  .currently-grid{display:grid;grid-template-columns:repeat(2,1fr);border-top:1px solid var(--border);border-left:1px solid var(--border)}.currently-grid article{min-height:180px;padding:1.6rem;border-right:1px solid var(--border);border-bottom:1px solid var(--border)}.currently-grid small{display:block;margin-bottom:2.5rem;color:var(--muted);font:.62rem var(--font-mono);letter-spacing:.09em}.currently-grid strong{font:500 clamp(1.45rem,2.2vw,2.3rem) var(--font-serif);color:var(--strong)}.currently-grid p{margin:.6rem 0 0;color:var(--muted);font-size:.82rem}
