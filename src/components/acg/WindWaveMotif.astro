---
interface Props {
  compact?: boolean;
  label?: string;
}
const { compact = false, label = 'Wind, sea and sound wave' } = Astro.props;
---

<div class:list={['wind-wave', { compact }]} role="img" aria-label={label}>
  <svg viewBox="0 0 720 420" aria-hidden="true">
    <path class="horizon" d="M18 278c102-8 151 17 231 4 83-14 134-63 222-42 79 19 127 8 231-27" />
    <path class="wave wave-a" d="M18 294c77-51 128 43 205 3 73-38 121-76 193-22 79 59 142-7 286-47" />
    <path class="wave wave-b" d="M18 314c90-33 140 31 221 2 96-35 132-40 211-7 73 30 142 2 252-47" />
    <path class="wind" d="M88 142c82-47 155-46 231-10 80 38 145 18 219-22" />
    <path class="wind wind-b" d="M180 104c55-31 106-35 162-12" />
    <circle class="moon" cx="566" cy="112" r="42" />
    <path class="bird" d="M432 104q12-11 24 0 12-11 24 0" />
    <path class="bird bird-b" d="M486 148q8-7 16 0 8-7 16 0" />
  </svg>
  <span class="axis axis-y">SUMMER / 2026</span>
  <span class="axis axis-x">WIND — SEA — SOUND</span>
  <i class="grain" aria-hidden="true"></i>
</div>

<style>
  .wind-wave { position: relative; min-height: 520px; overflow: hidden; border-left: 1px solid var(--border); color: var(--accent); }
  svg { position: absolute; inset: 6% -8% 0 0; width: 108%; height: 92%; }
  path, circle { fill: none; stroke: currentColor; stroke-width: 1.2; vector-effect: non-scaling-stroke; }
  .horizon { opacity: .18; }
  .wave { opacity: .42; animation: wave-shift 15s ease-in-out infinite alternate; }
  .wave-b { opacity: .2; animation-delay: -6s; animation-duration: 19s; }
  .wind { opacity: .14; animation: wind-drift 17s ease-in-out infinite alternate; }
  .wind-b { opacity: .09; animation-delay: -4s; }
  .moon { opacity: .2; stroke-width: 1; }
  .bird { opacity: .26; }
  .bird-b { opacity: .14; }
  .axis { position: absolute; color: var(--muted); font: 600 .6rem/1 var(--font-mono); letter-spacing: .16em; }
  .axis-y { top: 11%; left: 22px; writing-mode: vertical-rl; }
  .axis-x { right: 20px; bottom: 18px; }
  .grain { position: absolute; inset: 0; opacity: .025; pointer-events: none; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 160 160' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.8'/%3E%3C/svg%3E"); }
  .compact { min-height: 190px; border: 0; border-top: 1px solid var(--border); }
  .compact svg { inset: -38% 0 0; width: 100%; height: 145%; }
  .compact .axis { display: none; }
  @keyframes wave-shift { to { transform: translate3d(-16px, 5px, 0) scaleX(1.025); } }
  @keyframes wind-drift { to { transform: translate3d(22px, -4px, 0); } }
  @media (max-width: 800px) {
    .wind-wave { min-height: 340px; border-left: 0; border-top: 1px solid var(--border); }
  }
  @media (max-width: 560px) {
    .wind-wave { min-height: 260px; }
    .axis-y { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .wave, .wind { animation: none; }
  }
</style>
