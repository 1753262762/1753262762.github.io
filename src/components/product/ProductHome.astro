---
import type { CollectionEntry } from 'astro:content';
interface Props { posts: CollectionEntry<'blog'>[]; projects: CollectionEntry<'projects'>[]; }
const { posts, projects } = Astro.props;
---
<main id="top">
  <section class="product-hero">
    <div class="product-container">
      <p>Developer · Creator · Blogger</p>
      <h1><span>Ideas,</span><span>crafted into</span><strong>software.</strong></h1>
      <div class="hero-foot"><p>思考、构建、记录。<br />把模糊的念头变成可以运行的东西。</p><div><a class="product-button" href="#build">Explore my work</a><a class="product-link" href="#think">Read my journal ↗</a></div></div>
    </div>
    <div class="hero-orb" aria-hidden="true"><i></i><i></i><i></i></div>
  </section>

  <section class="story think" id="think">
    <div class="product-container story-grid"><div class="story-number">01</div><div class="story-copy"><p class="eyebrow">THINK.</p><h2>把复杂问题，<br />写成清晰路径。</h2><p>写作不是项目结束后的包装。它是理解系统、暴露假设和留下可复用经验的过程。</p><a href="/blog/">Explore all writing →</a></div><div class="feature-writing">{posts.slice(0,3).map((post,index)=><a href={`/blog/${post.id}/`}><small>0{index+1} / {post.data.category}</small><h3>{post.data.title}</h3><p>{post.data.description}</p><span>{post.data.readingTime} ↗</span></a>)}</div></div>
  </section>

  <section class="story build" id="build">
    <div class="product-container"><div class="story-title"><span>02</span><p class="eyebrow">BUILD.</p><h2>From first principles<br />to working systems.</h2></div>
      <div class="product-showcase">{projects.map((project,index)=><article class:list={[index%2 && 'reverse']}><div class="product-visual" data-index={`0${index+1}`}><div class="visual-window"><span></span><span></span><span></span><div class="visual-core"><i></i><b>{project.data.name.split(' ')[0]}</b></div></div></div><div class="product-copy"><small>{project.data.status} · PROJECT 0{index+1}</small><h3>{project.data.name}</h3><p>{project.data.description}</p><ul>{project.data.tech.map(tech=><li>{tech}</li>)}</ul><a href="#">View project ↗</a></div></article>)}</div>
    </div>
  </section>

  <section class="explore" id="about"><div class="product-container"><p class="eyebrow">03 / EXPLORE.</p><h2>Technology is only<br />one part of the story.</h2><div class="explore-grid"><article><span>ACG</span><strong>Stories that stay.</strong><p>关于动画、人物和那些值得反复想起的片段。</p></article><article><span>LIFE</span><strong>Outside the screen.</strong><p>设备、摄影、城市与一名互联网居民的日常。</p></article><article><span>NOTES</span><strong>Small discoveries.</strong><p>不必长成文章，也值得保存下来的小发现。</p></article></div></div></section>
  <footer class="product-footer"><div class="product-container"><p>One person.<br />Many curiosities.</p><div><a href="/about/">About</a><a href="/rss.xml">RSS</a><a href="/prototype/">Design Lab</a></div><span>© 2026 nabunana</span></div></footer>
</main>

<style>
  :global(.prototype-product){--bg:#f4f3ef;--surface:#fff;--surface-2:#e9e7e0;--text:#111;--muted:#66635d;--accent:#ff4d22;--border:rgb(0 0 0 / 12%)}
  :global(:root[data-theme='dark'] .prototype-product){--bg:#090909;--surface:#151515;--surface-2:#202020;--text:#f5f4ef;--muted:#9e9b94;--border:rgb(255 255 255 / 13%)}
  .product-container{width:min(calc(100% - 56px),1320px);margin:auto}.product-hero{position:relative;min-height:calc(100vh - 76px);display:flex;align-items:center;overflow:hidden}.product-hero>.product-container{position:relative;z-index:2;padding:8vh 0}.product-hero>.product-container>p{color:var(--muted);font-size:.75rem;text-transform:uppercase;letter-spacing:.16em}
  h1{margin:5vh 0;font-size:clamp(4.6rem,11vw,10.5rem);line-height:.78;letter-spacing:-.085em}.product-hero h1 span,.product-hero h1 strong{display:block}.product-hero h1 span:nth-child(2){padding-left:11vw}.product-hero h1 strong{text-align:right;color:var(--accent);font-weight:800}
  .hero-foot{display:grid;grid-template-columns:1fr 1fr;align-items:end}.hero-foot>p{color:var(--muted);font-size:1rem}.hero-foot>div{display:flex;justify-content:flex-end;align-items:center;gap:1.5rem}.product-button{display:inline-flex;min-height:48px;align-items:center;padding:.8rem 1.15rem;border-radius:999px;background:var(--text);color:var(--bg);font-weight:700}.product-link{font-size:.82rem}
  .hero-orb{position:absolute;width:min(35vw,520px);aspect-ratio:1;top:6%;right:11%;border-radius:50%;background:radial-gradient(circle at 30% 30%,#ffbf92,var(--accent) 42%,#8e1600 72%,transparent 73%);filter:blur(.2px);opacity:.74}.hero-orb i{position:absolute;inset:-12%;border:1px solid color-mix(in srgb,var(--accent) 25%,transparent);border-radius:50%}.hero-orb i:nth-child(2){inset:-26%}.hero-orb i:nth-child(3){inset:-40%}
  .story{padding:10rem 0}.story-grid{display:grid;grid-template-columns:70px minmax(270px,.8fr) 1.3fr;gap:5vw}.story-number{font:700 .8rem var(--font-mono);color:var(--accent)}.story-copy{position:sticky;top:5rem;height:max-content}.story-copy h2,.story-title h2,.explore h2{font-size:clamp(3rem,6vw,7rem);line-height:.94;letter-spacing:-.065em;margin:1.2rem 0}.story-copy>p{max-width:460px;color:var(--muted)}.story-copy>a{display:inline-block;margin-top:2rem;font-size:.82rem}
  .feature-writing{border-top:1px solid var(--text)}.feature-writing a{display:block;padding:2rem 0 2.4rem;border-bottom:1px solid var(--border)}.feature-writing small,.feature-writing span{color:var(--muted);font:.7rem var(--font-mono)}.feature-writing h3{font-size:clamp(1.4rem,2.7vw,2.6rem);line-height:1.08;letter-spacing:-.04em;margin:1rem 0}.feature-writing p{max-width:640px;color:var(--muted)}.feature-writing span{display:block;text-align:right}
  .build{background:var(--text);color:var(--bg)}.story-title{display:grid;grid-template-columns:70px 1fr;align-items:start}.story-title>span{font:.8rem var(--font-mono);color:var(--accent)}.story-title h2{grid-column:2;margin-top:0}.build .eyebrow{color:color-mix(in srgb,var(--bg) 55%,transparent)}
  .product-showcase{margin-top:9rem;display:grid;gap:12rem}.product-showcase article{display:grid;grid-template-columns:1.35fr .65fr;align-items:center;gap:7vw}.product-showcase article.reverse{grid-template-columns:.65fr 1.35fr}.product-showcase article.reverse .product-visual{order:2}.product-visual{position:relative;aspect-ratio:1.35;border-radius:40px;background:linear-gradient(145deg,#ff6a3c,#9e1e05);padding:6%;box-shadow:0 60px 120px rgb(0 0 0 / 30%)}.product-visual::before{content:attr(data-index);position:absolute;right:24px;top:18px;color:rgb(255 255 255 / 60%);font:700 .75rem var(--font-mono)}.visual-window{height:100%;padding:18px;border-radius:24px;background:#121212;box-shadow:0 25px 70px rgb(0 0 0 / 35%)}.visual-window>span{display:inline-block;width:8px;height:8px;margin-right:5px;border-radius:50%;background:#555}.visual-core{height:calc(100% - 20px);display:grid;place-items:center;position:relative;overflow:hidden}.visual-core i{position:absolute;width:62%;aspect-ratio:1;border:1px solid #ff6a3c;border-radius:50%;box-shadow:0 0 80px #ff4d22,inset 0 0 80px rgb(255 77 34 / 28%)}.visual-core b{z-index:1;color:#fff;font-size:clamp(2rem,5vw,5rem);letter-spacing:-.06em}.product-copy small{font:.7rem var(--font-mono);color:color-mix(in srgb,var(--bg) 50%,transparent)}.product-copy h3{font-size:clamp(2.2rem,4vw,4.8rem);line-height:1;letter-spacing:-.055em;margin:1rem 0}.product-copy p{color:color-mix(in srgb,var(--bg) 62%,transparent)}.product-copy ul{display:flex;flex-wrap:wrap;gap:.5rem;padding:0;list-style:none}.product-copy li{padding:.35rem .6rem;border:1px solid rgb(255 255 255 / 20%);border-radius:999px;font-size:.68rem}.product-copy a{display:inline-block;margin-top:2rem}
  .explore{padding:12rem 0}.explore-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;margin-top:6rem;background:var(--border)}.explore-grid article{min-height:330px;padding:2rem;display:flex;flex-direction:column;background:var(--bg)}.explore-grid span{color:var(--accent);font:.72rem var(--font-mono)}.explore-grid strong{margin-top:auto;font-size:1.8rem;letter-spacing:-.04em}.explore-grid p{color:var(--muted)}
  .product-footer{padding:8rem 0 10rem;background:var(--surface-2)}.product-footer>.product-container{display:grid;grid-template-columns:1fr auto;gap:4rem}.product-footer p{margin:0;font-size:clamp(3rem,7vw,7rem);line-height:.88;letter-spacing:-.07em}.product-footer div div{display:flex;gap:1.5rem}.product-footer span{color:var(--muted);font-size:.75rem}
  @media(max-width:800px){.product-container{width:calc(100% - 30px)}h1{font-size:clamp(4rem,18vw,7rem)}.product-hero h1 span:nth-child(2){padding-left:0}.hero-orb{width:60vw;right:-20%;top:10%}.hero-foot,.story-grid{grid-template-columns:1fr}.hero-foot>div{justify-content:flex-start;margin-top:2rem}.story-number{display:none}.story-copy{position:static}.product-showcase{gap:7rem}.product-showcase article,.product-showcase article.reverse{grid-template-columns:1fr}.product-showcase article.reverse .product-visual{order:0}.story-title{grid-template-columns:1fr}.story-title h2{grid-column:1}.explore-grid{grid-template-columns:1fr}.explore-grid article{min-height:240px}.product-footer>.product-container{grid-template-columns:1fr}}
</style>
