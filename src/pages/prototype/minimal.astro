---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PrototypeHeader from '../../components/common/PrototypeHeader.astro';
import MinimalHome from '../../components/minimal/MinimalHome.astro';
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a,b)=>b.data.published.valueOf()-a.data.published.valueOf());
const projects = await getCollection('projects');
---
<BaseLayout title="Minimal Prototype · nabunana" description="安静、编辑化、Typography 驱动的个人数字花园。" prototype="minimal">
  <PrototypeHeader variant="minimal" />
  <MinimalHome {posts} {projects} />
</BaseLayout>
