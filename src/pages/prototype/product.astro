---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PrototypeHeader from '../../components/common/PrototypeHeader.astro';
import ProductHome from '../../components/product/ProductHome.astro';
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a,b)=>b.data.published.valueOf()-a.data.published.valueOf());
const projects = await getCollection('projects');
---
<BaseLayout title="Product Prototype · nabunana" description="把个人、写作与项目组织成产品级滚动叙事。" prototype="product" lightingRegister="quiet">
  <PrototypeHeader variant="product" />
  <ProductHome {posts} {projects} />
</BaseLayout>
