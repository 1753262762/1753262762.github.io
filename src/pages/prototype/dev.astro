---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DevHome from '../../components/dev/DevHome.astro';
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a,b)=>b.data.published.valueOf()-a.data.published.valueOf());
const projects = await getCollection('projects');
---
<BaseLayout title="Developer Prototype · nabunana" description="像个人操作系统一样高效、可搜索的开发者网站。" prototype="dev" lightingRegister="quiet">
  <DevHome {posts} {projects} />
</BaseLayout>
