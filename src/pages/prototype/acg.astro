---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PrototypeHeader from '../../components/common/PrototypeHeader.astro';
import AcgHome from '../../components/acg/AcgHome.astro';
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a,b)=>b.data.published.valueOf()-a.data.published.valueOf());
const projects = await getCollection('projects');
const notes = (await getCollection('notes')).sort((a,b)=>b.data.created.valueOf()-a.data.created.valueOf());
---
<BaseLayout title="ACG Prototype · nabunana" description="一名二次元开发者自己的网络房间。" prototype="acg" lightingIntensity="display" lightingRegister="threshold">
  <PrototypeHeader variant="acg" />
  <AcgHome {posts} {projects} {notes} />
</BaseLayout>
