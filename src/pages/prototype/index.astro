---
import BaseLayout from '../../layouts/BaseLayout.astro';
const directions = [
  { id:'minimal', no:'01', name:'Minimal', line:'Quiet & Editorial', words:['Typography','Reading','Calm'], note:'让文章与留白成为主角。适合长期写作，维护成本最低。' },
  { id:'acg', no:'02', name:'ACG', line:'Playful & Personal', words:['Illustration','Room','Stories'], note:'更鲜明的个人身份与兴趣展示，像一间可持续布置的网络房间。' },
  { id:'product', no:'03', name:'Product', line:'Bold & Cinematic', words:['Storytelling','Scale','Motion'], note:'把个人与项目当作产品叙事，视觉冲击最强，适合作品集首页。' },
  { id:'dev', no:'04', name:'Developer', line:'Technical & Functional', words:['Terminal','Command','Dense'], note:'开发者个人 OS，搜索与信息效率优先，技术辨识度最高。' },
];
---
<BaseLayout title="Design Lab · nabunana" description="四套可运行的个人博客设计原型。">
  <main class="lab">
    <header class="lab-head"><a href="/">W·</a><div><button type="button" data-search-open aria-label="打开搜索">Search ⌘K</button></div></header>
    <section class="lab-intro"><p class="eyebrow">WEIZI / DESIGN LAB / 2026</p><h1>Choose a<br /><em>direction.</em></h1><p>四套真实运行的首页，共享同一份内容与功能基础。请进入、滚动、点击并在不同设备尺寸下比较，而不只是看一张静态截图。</p></section>
    <section class="direction-grid" aria-label="设计方向列表">
      {directions.map((item)=><article class={`direction ${item.id}`}>
        <div class="direction-meta"><span>{item.no}</span><div><h2>{item.name}</h2><p>{item.line}</p></div></div>
        <div class="preview" aria-hidden="true"><div class="preview-nav"><i></i><span></span><span></span><span></span></div><div class="preview-body"><b>{item.id==='dev'?'> whoami':item.id==='product'?'Ideas,':item.id==='acg'?'おかえり。':'Hello, I’m'}</b><strong>{item.id==='dev'?'nabunana_':item.id==='product'?'crafted.':item.id==='acg'?'my little room':'nabunana.'}</strong><div><i></i><i></i><i></i></div></div></div>
        <p class="note">{item.note}</p><div class="words">{item.words.map(word=><span>{word}</span>)}</div><a href={`/prototype/${item.id}/`}>Open prototype <span>↗</span></a>
      </article>)}
    </section>
    <footer><span>Built with Astro · Zero framework islands</span><a href="/blog/">View shared content →</a></footer>
  </main>
</BaseLayout>

<style>
  .lab{width:min(calc(100% - 48px),1320px);margin:auto;padding-bottom:5rem}.lab-head{height:80px;display:flex;justify-content:space-between;align-items:center}.lab-head>a{font-weight:900;font-size:1.4rem}.lab-head div{display:flex;gap:.5rem}.lab-head button{min-height:40px;padding:.5rem .8rem;border:1px solid var(--border);border-radius:999px;background:transparent;color:var(--text);cursor:pointer}.lab-intro{padding:10vh 0 12vh;display:grid;grid-template-columns:1fr 1fr;align-items:end}.lab-intro .eyebrow{grid-column:1/-1}.lab-intro h1{margin:1rem 0 0;font-size:clamp(4.5rem,11vw,10rem);line-height:.78;letter-spacing:-.085em}.lab-intro h1 em{font-family:var(--font-serif);font-weight:400;color:var(--accent)}.lab-intro>p:last-child{max-width:500px;margin:0 0 0 auto;color:var(--muted)}.direction-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem}.direction{padding:1.5rem;border:1px solid var(--border);border-radius:28px;background:var(--surface);overflow:hidden}.direction-meta{display:flex;gap:1.5rem;align-items:start}.direction-meta>span{color:var(--muted);font:.72rem var(--font-mono)}.direction h2{margin:0;font-size:2rem;letter-spacing:-.05em}.direction-meta p{margin:0;color:var(--muted);font-size:.8rem}.preview{height:360px;margin:2rem 0;border-radius:18px;background:var(--surface-2);border:1px solid var(--border);overflow:hidden;transition:transform .4s var(--ease)}.direction:hover .preview{transform:scale(.985)}.preview-nav{height:42px;display:flex;align-items:center;gap:.5rem;padding:0 1rem;border-bottom:1px solid var(--border)}.preview-nav i{width:9px;height:9px;border-radius:50%;background:var(--accent)}.preview-nav span{width:36px;height:4px;border-radius:4px;background:var(--border)}.preview-body{height:calc(100% - 42px);padding:3rem;display:flex;flex-direction:column}.preview-body>b,.preview-body>strong{font-size:clamp(2rem,5vw,4.8rem);line-height:.9;letter-spacing:-.06em}.preview-body>strong{color:var(--accent)}.preview-body>div{display:grid;grid-template-columns:repeat(3,1fr);gap:.5rem;margin-top:auto}.preview-body i{height:44px;border:1px solid var(--border);border-radius:8px}.direction.acg{--accent:#ff6fae}.direction.acg .preview{background:linear-gradient(145deg,#fff7fb,#eeeaff)}.direction.acg .preview-body>b{font-family:var(--font-serif)}.direction.acg .preview-body i{border-radius:14px;background:rgb(255 255 255 / 60%)}.direction.product{--accent:#ff4d22}.direction.product .preview-body>b,.direction.product .preview-body>strong{font-size:clamp(3rem,6vw,6rem)}.direction.dev{--accent:#7ee787}.direction.dev .preview{background:#0c0e12;color:#e8edf5;font-family:var(--font-mono)}.direction.dev .preview-body>b{font-size:1rem;color:#7ee787}.direction.dev .preview-body>strong{font-family:var(--font-sans)}.note{min-height:3.2rem;color:var(--muted);font-size:.85rem}.words{display:flex;gap:.4rem}.words span{padding:.3rem .55rem;border:1px solid var(--border);border-radius:999px;color:var(--muted);font-size:.65rem}.direction>a{margin-top:1.5rem;padding-top:1rem;border-top:1px solid var(--border);display:flex;justify-content:space-between;font-weight:700}.direction>a span{color:var(--accent)}.lab>footer{display:flex;justify-content:space-between;margin-top:4rem;padding-top:2rem;border-top:1px solid var(--border);color:var(--muted);font-size:.72rem}
  @media(max-width:760px){.lab{width:calc(100% - 28px)}.lab-intro{grid-template-columns:1fr;padding-top:7vh}.lab-intro>p:last-child{margin:3rem 0 0}.direction-grid{grid-template-columns:1fr}.preview{height:280px}.preview-body{padding:2rem}.lab>footer{flex-direction:column;gap:1rem}}
</style>
