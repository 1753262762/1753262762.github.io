---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/common/SiteHeader.astro';
import WindWaveMotif from '../../components/acg/WindWaveMotif.astro';

export async function getStaticPaths(){
  const posts=(await getCollection('blog',({data})=>!data.draft)).sort((a,b)=>b.data.published.valueOf()-a.data.published.valueOf());
  return posts.map((post,index)=>({params:{id:post.id},props:{post,newer:posts[index-1]??null,older:posts[index+1]??null}}));
}
const { post, newer, older }=Astro.props;
const { Content, headings }=await render(post);
const articleSchema={"@context":"https://schema.org","@type":"BlogPosting",headline:post.data.title,description:post.data.description,datePublished:post.data.published.toISOString(),dateModified:(post.data.updated??post.data.published).toISOString(),author:{"@type":"Person",name:'nabunana',url:'https://github.com/1753262762'},mainEntityOfPage:Astro.url.href};
---
<BaseLayout title={`${post.data.title} · nabunana`} description={post.data.description} pageClass="acg-site" lightingIntensity="reading">
  <SiteHeader current="writing" />
  <div class="reading-progress" data-reading-progress></div>
  <article class="article-page">
    <header class="article-hero container">
      <div class="article-heading"><a href="/blog/">← 文章 / Writing</a><p><span>{post.data.category}</span><time datetime={post.data.published.toISOString()}>{post.data.published.toLocaleDateString('zh-CN')}</time><b>{post.data.readingTime}</b><a href="https://github.com/1753262762" target="_blank" rel="author me noopener">编者 nabunana ↗</a></p><h1>{post.data.title}</h1><div class="description">{post.data.description}</div><footer>{post.data.tags.map((tag)=><span>#{tag}</span>)}</footer></div>
      <WindWaveMotif compact label="Article wind and wave divider" />
    </header>
    <div class="article-content container">
      <div class="prose"><Content /></div>
      {headings.some((heading)=>heading.depth===2) && <aside><p>文章目录<br /><span>ON THIS PAGE</span></p>{headings.filter((heading)=>heading.depth===2).map((heading)=><a href={`#${heading.slug}`}>{heading.text}</a>)}</aside>}
    </div>
    <section class="after-reading container">
      <div class="listening-note"><small>今聴いている / NOW LISTENING</small><strong>Yorushika</strong><p>读完之后，留一点安静给音乐。这是一则状态记录，不是播放器。</p></div>
      <nav aria-label="相邻文章">{older ? <a href={`/blog/${older.id}/`}><small>上一篇 / OLDER</small><strong>{older.data.title}</strong></a> : <span></span>}{newer ? <a href={`/blog/${newer.id}/`}><small>下一篇 / NEWER</small><strong>{newer.data.title}</strong></a> : <a href="/blog/"><small>返回</small><strong>全部文章</strong></a>}</nav>
    </section>
  </article>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script>
    let readingProgressAbort: AbortController | undefined;
    const bindReadingProgress = () => {
      readingProgressAbort?.abort();
      readingProgressAbort = new AbortController();
      const bar = document.querySelector<HTMLElement>('[data-reading-progress]');
      if (!bar) return;
      const update = () => {
        const max = document.documentElement.scrollHeight - innerHeight;
        bar.style.setProperty('scale', `${max > 0 ? scrollY / max : 0} 1`);
      };
      addEventListener('scroll', update, { passive: true, signal: readingProgressAbort.signal });
      update();
    };
    document.addEventListener('astro:page-load', bindReadingProgress);
    bindReadingProgress();
  </script>
</BaseLayout>

<style>
  :global(:root[data-environment='night'] body.acg-site[data-lighting-intensity='reading']){--bg:#122a27;--surface:#193631;--surface-2:#20403a;--text:#e7f0ed;--strong:#f3f8f6;--muted:#9eb3ae;--accent:#78c5bb;--accent-deep:#91d6cd;--border:rgb(174 222 215 / 15%);background:var(--bg)}
  .article-hero{display:grid;grid-template-columns:1fr .45fr;align-items:end;min-height:650px;border-bottom:1px solid var(--border)}.article-heading{padding:7rem 4rem 6rem 0}.article-heading>a{color:var(--muted);font-size:.72rem}.article-heading>p{display:flex;flex-wrap:wrap;gap:1rem;margin:4rem 0 2rem;color:var(--muted);font:.62rem var(--font-mono);letter-spacing:.08em}.article-heading>p span{color:var(--accent-deep)}.article-heading>p b{font-weight:500}.article-heading h1{max-width:900px;margin:0;color:var(--strong);font:500 clamp(2.8rem,6.4vw,6.2rem)/1.02 var(--font-serif);letter-spacing:-.055em}.description{max-width:720px;margin:2rem 0;color:var(--muted);font:400 1.05rem/1.7 var(--font-serif)}.article-heading footer{display:flex;flex-wrap:wrap;gap:.6rem;color:var(--muted);font-size:.62rem}.article-hero :global(.wind-wave){align-self:stretch;min-height:100%;border-left:1px solid var(--border);border-top:0}.article-content{display:grid;grid-template-columns:minmax(0,720px) 180px;justify-content:center;gap:5rem;padding:clamp(5rem,9vw,9rem) 0}.article-content :global(.prose){width:100%;font-size:1.05rem;line-height:1.85}.article-content aside{position:sticky;top:2rem;height:max-content;padding-top:1rem;border-top:1px solid var(--border)}.article-content aside p{color:var(--text);font:600 .7rem/1.5 var(--font-serif)}.article-content aside p span{color:var(--muted);font:.55rem var(--font-mono);letter-spacing:.1em}.article-content aside a{display:block;margin:.8rem 0;color:var(--muted);font-size:.68rem}.article-content aside a:hover{color:var(--accent-deep)}.after-reading{padding:0 0 10rem}.listening-note{display:grid;grid-template-columns:190px 1fr 1fr;gap:2rem;align-items:baseline;padding:2rem 0;border-block:1px solid var(--border)}.listening-note small{color:var(--accent);font:.6rem var(--font-mono)}.listening-note strong{font:500 2rem var(--font-serif)}.listening-note p{margin:0;color:var(--muted);font-size:.75rem}.after-reading nav{display:grid;grid-template-columns:1fr 1fr;margin-top:5rem;border-top:1px solid var(--border)}.after-reading nav>a{display:grid;gap:.6rem;padding:1.8rem 2rem 1.8rem 0;border-bottom:1px solid var(--border)}.after-reading nav>a+a{padding-left:2rem;border-left:1px solid var(--border)}.after-reading nav small{color:var(--accent);font:.58rem var(--font-mono)}.after-reading nav strong{font:500 1.15rem var(--font-serif)}
  @media(max-width:900px){.article-hero{grid-template-columns:1fr;min-height:auto}.article-heading{padding:5rem 0 4rem}.article-hero :global(.wind-wave){min-height:180px;border-left:0;border-top:1px solid var(--border)}.article-content{grid-template-columns:minmax(0,720px)}.article-content aside{display:none}}
  @media(max-width:600px){.article-heading>p{margin-top:3rem}.listening-note{grid-template-columns:1fr;gap:.8rem}.after-reading nav{grid-template-columns:1fr}.after-reading nav>a+a{padding-left:0;border-left:0}}
</style>
